{
  // Test files, kept in their own project so `tsconfig.app.json` can exclude them.
  // The app project supplies the browser settings, and `exclude` is reset because
  // the app project excludes the very files this project exists to check: an
  // inherited `exclude` filters this project's own `include`, which would leave
  // the specs out of the project without `tsc -b` reporting anything.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.spec.tsbuildinfo"
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.spec.ts", "src/**/*.spec.tsx", "src/vite-env.d.ts"],
  "exclude": []
}
