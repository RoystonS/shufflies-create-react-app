{
  "name": "@shufflies/create-react-app",
  "version": "0.0.0-semantically-released",
  "description": "Scaffold a Vite + React + TypeScript app with Vitest, oxlint and oxfmt",
  "keywords": [
    "create",
    "oxfmt",
    "oxlint",
    "react",
    "scaffold",
    "template",
    "typescript",
    "vite",
    "vitest"
  ],
  "license": "MIT",
  "author": "Royston Shufflebotham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoystonS/shufflies-create-react-app.git"
  },
  "bin": {
    "create-shufflies-react-app": "dist/cli.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.generator.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.generator.json --noEmit && tsc -p tsconfig.spec.json && tsc -p tsconfig.scripts.json",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "pretest:scaffold": "npm run build",
    "test:scaffold": "node --test test/scaffold.integration.ts",
    "scaffold:demo": "node scripts/create-demo.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@shufflies/oxlint-config": "^1.3.0",
    "@types/node": "^26.6.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "npm@12.1.0"
}
