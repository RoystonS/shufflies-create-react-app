{
  // The Playwright tests and the story gallery they drive: Node globals for the
  // tests that run under the Playwright runner, and DOM types plus JSX for the
  // gallery, which is a page the browser renders.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.playwright.tsbuildinfo",
    "target": "es2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "playwright", "tests", "src/vite-env.d.ts"]
}
